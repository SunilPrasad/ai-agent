<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>basic_rag</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.VectorData.InMemory" Version="1.0.1" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.19.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="documents\*.txt"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="documents\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
